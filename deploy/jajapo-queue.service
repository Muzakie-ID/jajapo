# Worker antrean Jajapo (notifikasi, email, web push).
# sudo cp deploy/jajapo-queue.service /etc/systemd/system/ && sudo systemctl enable --now jajapo-queue
[Unit]
Description=Jajapo queue worker
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/jajapo/current
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
