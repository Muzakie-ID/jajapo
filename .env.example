APP_NAME=Jajapo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produksi memakai PostgreSQL. Untuk coba cepat tanpa PostgreSQL: DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jajapo
DB_USERNAME=jajapo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@jajapo.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login Google (Google Cloud Console > Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Payment gateway milik platform: "fake" untuk lokal, "http" untuk gateway asli
PAYMENT_GATEWAY_DRIVER=fake
PAYMENT_GATEWAY_URL=https://api-qris.muzakie.cloud
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

JAJAPO_TIMEZONE=Asia/Jakarta
JAJAPO_SELLER_EMAIL_DOMAIN=mail.ugm.ac.id

# Notifikasi push di HP (PWA). Buat dengan: php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@jajapo.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
